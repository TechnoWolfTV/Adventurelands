msgid "Whitelist"
msgstr "Liste blanche"

msgid "Manage who can and who can't enter in your server"
msgstr "Gérez qui peut et ne peut pas entrer dans votre serveur"

msgid "You're not whitelisted!"
msgstr "Tu n'es pas sur liste blanche !"

msgid "Whitelist commands. <player> is only needed for `add` and `remove`"
msgstr ""
"Commandes de liste blanche. <joueur> est seulement nécessaire pour `add` et "
"`remove`"

msgid "player"
msgstr "joueur"

msgid "[!] The whitelist is already enabled!"
msgstr "[!] La liste blanche est déjà active !"

msgid "Whitelist successfully enabled"
msgstr "Liste blanche activée avec succès"

msgid "[!] The whitelist is already disabled!"
msgstr "[!] La liste blanche est déjà désactivée !"

msgid "Whitelist successfully disabled"
msgstr "Liste blanche désactivée avec succès"

msgid "[!] @1 is already whitelisted!"
msgstr "[!] @1 est déjà sur liste blanche !"

msgid "[!] There is no player whitelisted with that name..."
msgstr "[!] Il n'y a pas de joueur sur liste blanche avec ce nom…"

msgid "[!] You can't remove yourself!"
msgstr "[!] Vous ne pouvez vous supprimer vous-même !"

msgid "[!] Whitelist can't be empty when enabled!"
msgstr "[!] La liste blanche ne peut pas être vide lorsqu'elle est activée !"

msgid "Whitelisted players: @1"
msgstr "Joueurs sur liste blanche : @1"
