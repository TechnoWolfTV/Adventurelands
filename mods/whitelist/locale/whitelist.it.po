msgid "Whitelist"
msgstr "Lista bianca"

msgid "Manage who can and who can't enter in your server"
msgstr "Gestisci chi può e chi non può entrare nel tuo server"

msgid "You're not whitelisted!"
msgstr "Non sei nella lista bianca!"

msgid "Whitelist commands. <player> is only needed for `add` and `remove`"
msgstr ""
"Comandi lista bianca. <giocante> è richiesto solamente per `add` e `remove`"

msgid "player"
msgstr "giocante"

msgid "[!] The whitelist is already enabled!"
msgstr "[!] La lista bianca è già abilitata!"

msgid "Whitelist successfully enabled"
msgstr "Lista bianca abilitata con successo"

msgid "[!] The whitelist is already disabled!"
msgstr "[!] La lista bianca è già disabilitata!"

msgid "Whitelist successfully disabled"
msgstr "Lista bianca disabilitata con successo"

msgid "[!] @1 is already whitelisted!"
msgstr "[!] @1 è già nella lista bianca!"

msgid "[!] There is no player whitelisted with that name..."
msgstr "[!] Nessunə giocante con quel nome è presente nella lista bianca..."

msgid "[!] You can't remove yourself!"
msgstr "[!] Non puoi rimuovere te stessə!"

msgid "[!] Whitelist can't be empty when enabled!"
msgstr "[!] La lista bianca non può essere vuota quand'è attiva!"

msgid "Whitelisted players: @1"
msgstr "Giocanti in lista bianca: @1"
