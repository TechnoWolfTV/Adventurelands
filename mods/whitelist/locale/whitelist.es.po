msgid "Whitelist"
msgstr "Lista blanca"

msgid "Manage who can and who can't enter in your server"
msgstr "Maneja quien y quien no puede entrar a tu servidor"

msgid "You're not whitelisted!"
msgstr "¡No estás en la lista blanca!"

msgid "Whitelist commands. <player> is only needed for `add` and `remove`"
msgstr ""
"Comandos de la lista blanca. <jugador> es lo único necesario para `add` y "
"`remove`"

msgid "player"
msgstr "jugador"

msgid "[!] The whitelist is already enabled!"
msgstr "[!] ¡La lista blanca ya está activada!"

msgid "Whitelist successfully enabled"
msgstr "Lista blanca activada correctamente"

msgid "[!] The whitelist is already disabled!"
msgstr "[!] ¡La lista blanca ya está desactivada!"

msgid "Whitelist successfully disabled"
msgstr "Lista blanca desactivada correctamente"

msgid "[!] @1 is already whitelisted!"
msgstr "[!] ¡@1 ya está en la lista blanca!"

msgid "[!] There is no player whitelisted with that name..."
msgstr "[!] No hay ningún jugador en la lista blanca con ese nombre..."

msgid "[!] You can't remove yourself!"
msgstr "[!] ¡No puedes eliminarte a ti mismo!"

msgid "[!] Whitelist can't be empty when enabled!"
msgstr "[!] ¡La lista blanca no puede estar vacía cuando está habilitada!"

msgid "Whitelisted players: @1"
msgstr "Jugadores en la lista blanca: @1"
