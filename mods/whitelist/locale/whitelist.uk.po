msgid "Whitelist"
msgstr "Білий список"

msgid "Manage who can and who can't enter in your server"
msgstr "Керуй, хто може і не може входити на твій сервер"

msgid "You're not whitelisted!"
msgstr "Тебе немає у білому списку!"

msgid "Whitelist commands. <player> is only needed for `add` and `remove`"
msgstr "Команди білого списку. <гравець> потрібний лише для «add» та «remove»"

msgid "player"
msgstr "гравець"

msgid "[!] The whitelist is already enabled!"
msgstr "[!] Білий список вже увімкнено!"

msgid "Whitelist successfully enabled"
msgstr "Білий список успішно увімкнено"

msgid "[!] The whitelist is already disabled!"
msgstr "[!] Білий список уже вимкнено!"

msgid "Whitelist successfully disabled"
msgstr "Білий список успішно вимкнено"

msgid "[!] @1 is already whitelisted!"
msgstr "[!] @1 вже у білому списку!"

msgid "[!] There is no player whitelisted with that name..."
msgstr "[!] Гравець із таким іменем не у білому списку..."

msgid "[!] You can't remove yourself!"
msgstr "[!] Ти не можеш видалити себе!"

msgid "[!] Whitelist can't be empty when enabled!"
msgstr "[!] Білий список не може бути пустим, коли він увімкнений!"

msgid "Whitelisted players: @1"
msgstr "Гравці у білому списку: @1"
